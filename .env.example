# ========== 端口（宿主机映射）==========
APP_PORT=18080
POSTGRES_PORT=5432
REDIS_PORT=6379
FRONTEND_PORT=5173

# ========== 数据库 ==========
POSTGRES_USER=cardkey
POSTGRES_PASSWORD=请改成强密码
POSTGRES_DB=cardkey

# ========== 应用密钥 ==========
# ≥32 字符随机串
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# 64 位 hex（openssl rand -hex 32），多实例必须一致
CONTENT_KEY=

# ========== 首次管理员（可选）==========
# 两者都留空：首次打开管理端走「安装向导」设置账号（推荐，对齐 sub2api）
# 若设置了 BOOTSTRAP_ADMIN_PASS：启动时自动创建管理员（mustChangePassword=true）
BOOTSTRAP_ADMIN_USER=
BOOTSTRAP_ADMIN_PASS=

# 公开兑换密钥（可空，向导/启动时自动生成）
PUBLIC_REDEEM_API_KEY=

# ========== 运行 ==========
APP_ENV=production
CORS_ORIGINS=http://localhost:18080,http://127.0.0.1:18080
SECURE_COOKIE=false
TRUST_PROXY=true
CSRF_CHECK=false
REQUIRE_REDEEM_API_KEY=false

# ========== 在线更新（默认启用）==========
# docker=容器部署（仅检测，提示 compose pull）；binary=裸机可一键下载替换；disabled=关闭
UPDATE_MODE=docker
UPDATE_GITHUB_OWNER=hkx1997
UPDATE_GITHUB_REPO=CardKey
# 私有仓库或提高 API 限额时再填
UPDATE_GITHUB_TOKEN=
