# ========== 端口（宿主机映射）==========
APP_PORT=18080
POSTGRES_PORT=5432
REDIS_PORT=6379
FRONTEND_PORT=5173

# ========== 数据卷名（升级勿乱改；挂旧数据时填 docker volume ls 里的名字）==========
# POSTGRES_VOLUME_NAME=cardkey_postgres_data
# APP_VOLUME_NAME=cardkey_app_data
# REDIS_VOLUME_NAME=cardkey_redis_data

# ========== 数据库 ==========
POSTGRES_USER=cardkey
POSTGRES_PASSWORD=请改成强密码
POSTGRES_DB=cardkey

# ========== 应用密钥（生产必填，勿用示例值）==========
# ≥32 字符随机串（勿包含 change-me / local-dev / please-rotate）
JWT_SECRET=
# 64 位 hex：openssl rand -hex 32
CONTENT_KEY=

# ========== 首次管理员（可选）==========
# 两者都留空：首次打开管理端走「安装向导」设置账号（推荐）
BOOTSTRAP_ADMIN_USER=
BOOTSTRAP_ADMIN_PASS=

# 公开兑换密钥（可空，向导/启动时自动生成）
PUBLIC_REDEEM_API_KEY=

# ========== 运行 ==========
APP_ENV=production
CORS_ORIGINS=http://localhost:18080,http://127.0.0.1:18080
# HTTPS 反代后生产默认 Secure Cookie；仅 HTTP 调试可 SECURE_COOKIE=false
SECURE_COOKIE=true
# 仅反代后为 true；直连时 false，防止伪造 X-Forwarded-For 击穿限流
TRUST_PROXY=true
# 浏览器 Cookie 写操作同源校验（生产强制 true）
CSRF_CHECK=true
# 生产强制 true：Redis 不可用则拒绝启动（限流/JWT 吊销依赖）
REQUIRE_REDIS=true
# 生产限流后端故障时拒绝请求
RATE_LIMIT_FAIL_CLOSED=true
REQUIRE_REDEEM_API_KEY=false
# 生产建议设置：保护 /metrics，请求头 Authorization: Bearer 或 X-Metrics-Token
METRICS_TOKEN=
# DATABASE_URL 内网 Docker 可用 sslmode=disable（会记 WARN）；公网库请 TLS

# ========== 兑换人机验证（Cloudflare Turnstile，可选）==========
# 设置页打开「兑换人机验证」后，需同时配置下列两项才会对浏览器兑换生效
# API Key（redeem:api）调用可跳过验证码
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET_KEY=

# 大文件卡密可选落盘（相对 DATA_DIR 或绝对路径）；空=仅数据库
# OBJECT_STORAGE_DIR=objects

# ========== 在线更新 ==========
# docker=容器仅检测；binary=裸机替换；disabled=关闭
UPDATE_MODE=docker
UPDATE_GITHUB_OWNER=hkx1997
UPDATE_GITHUB_REPO=CardKey
# 建议填写 PAT，避免 GitHub 匿名 API 限流
UPDATE_GITHUB_TOKEN=
